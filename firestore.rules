rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && (
          request.auth.token.email == 'danielolorunlana59@gmail.com' ||
          request.auth.token.email == 'dannistec3@gmail.com' ||
          request.auth.token.email.matches('(?i)^(danielolorunlana59@gmail\\.com|dannistec3@gmail\\.com)$')
        );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles & Settings
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && (!('id' in incoming()) || incoming().id == userId)
                    && incoming().email is string
                    && incoming().email.size() <= 200;
      allow update: if isOwner(userId)
                    && (!('id' in incoming()) || incoming().id == userId)
                    && (
                      !('email' in existing()) ||
                      existing().email == '' ||
                      incoming().email.lower() == existing().email.lower()
                    );
      allow delete: if isOwner(userId) || isAdmin();

      // Private User Subcollections
      match /tutor_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /cbt_quizzes/{quizId} {
        allow read, write: if isOwner(userId);
      }

      match /weak_topics/{topicId} {
        allow read, write: if isOwner(userId);
      }

      match /scanned_notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /spaced_repetition/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
      }

      match /portfolio/{studyId} {
        allow read, write: if isOwner(userId);
      }

      match /portfolio_studies/{studyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Public Solutions Library
    match /solutions_library/{solutionId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && isValidId(solutionId)
                    && incoming().authorId == request.auth.uid
                    && incoming().problemTitle is string
                    && incoming().problemTitle.size() <= 300;

      allow update: if isSignedIn();

      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
    }

    // 3. Contact & Support Messages
    match /messages/{messageId} {
      allow create: if isSignedIn()
                    && isValidId(messageId)
                    && incoming().userId == request.auth.uid;
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Engineering Student Community Posts & Interactive Discussions
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && isValidId(postId)
                    && incoming().authorId == request.auth.uid
                    && incoming().title is string
                    && incoming().title.size() <= 300;
      allow update: if isSignedIn();
      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && isValidId(commentId)
                      && incoming().authorId == request.auth.uid
                      && incoming().content is string
                      && incoming().content.size() <= 2000;
        allow update: if isSignedIn() && existing().authorId == request.auth.uid;
        allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || isAdmin();
      }
    }
  }
}
