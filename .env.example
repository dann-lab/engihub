# -----------------------------------------------------------------------------
# Netlify Environment Variables Configuration
# Set these under: Netlify Site Settings -> Environment variables
# -----------------------------------------------------------------------------

# 1. Gemini API Key (Required for all AI modules on Netlify)
# Read strictly server-side by netlify/functions/ai.mjs
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=""

# 2. Gemini Model (Optional, defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# 3. Email Notification Service (Optional - for Area 5 Contact System)
# Free API key from Resend (resend.com)
# When set, every student inquiry sends an email alert to the admin,
# and replies from the admin console are delivered to the student's inbox.
RESEND_API_KEY=""

# 4. Admin Notification Email (Optional, defaults to dannistec3@gmail.com)
ADMIN_NOTIFICATION_EMAIL="dannistec3@gmail.com"

# 5. WhatsApp Support Number (Optional, defaults to 09040110170)
# Format with country code without + sign (e.g., 2349040110170)
VITE_WHATSAPP_NUMBER="2349040110170"

# -----------------------------------------------------------------------------
# Firebase Client Configuration (Optional overrides if using custom project)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
